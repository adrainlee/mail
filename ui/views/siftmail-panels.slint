// Siftmail settings pages. All state and callbacks go through the
// `SiftmailBridge` global so the Rust controller (src/siftmail_controller.rs)
// can drive them without threading properties through the window tree.
import { ScrollView, ComboBox } from "std-widgets.slint";
import { AppTheme } from "../design-system.slint";
import { TypeScale } from "../typography.slint";
import { Button } from "../components/button.slint";
import { LineEdit } from "../components/controls.slint";

export struct SchedulerRow {
    provider: string,
    accounts: string,
    level: int,
    remaining: string,
    last-error: string,
    backing-off: bool,
}

export struct CategoryItem { id: string, name: string, description: string }
export struct RuleItem { id: int, category-index: int, category-name: string, name: string, field-index: int, op-index: int, value: string, summary: string, editable: bool, enabled: bool }
export struct SuggestionItem { id: int, title: string, category-index: int, category-name: string, confidence: string, rationale: string }

export struct ProxyItem { id: int, name: string, kind-index: int, host: string, port: string, username: string, has-password: bool }
export struct AccountProxyItem { account-id: int, email: string, mode-index: int, proxy-index: int }

export global SiftmailBridge {
    // Sub-page inside the Siftmail settings tab.
    in-out property <string> page: "scheduler";
    in-out property <string> status: "";

    // Scheduler status
    in property <[SchedulerRow]> scheduler-rows: [];
    callback refresh-scheduler();
    callback reset-backoff(string);

    // Categories, rules and AI suggestion review
    in property <[CategoryItem]> categories: [];
    in property <[string]> category-names: [];
    in property <[RuleItem]> rules: [];
    in property <[SuggestionItem]> suggestions: [];
    // Display names; the controller maps indexes to subject/body/sender…
    out property <[string]> rule-fields: [@tr("Subject"), @tr("Keyword (body)"), @tr("Sender address"), @tr("Sender domain"), @tr("Sender name"), @tr("Recipient")];
    out property <[string]> rule-ops: [@tr("contains"), @tr("equals"), @tr("wildcard"), @tr("regex")];
    callback refresh-categories();
    callback save-category(string /* id, empty = new */, string /* name */, string /* description */);
    callback delete-category(string);
    callback save-rule(int /* id, 0 = new */, int /* category index */, string /* name */, int /* field */, int /* op */, string /* value */, bool /* enabled */);
    callback delete-rule(int);
    callback apply-rules-now();
    callback run-ai-suggestions();
    // Accept applies only the category the user picked in the row.
    callback accept-suggestion(int /* id */, int /* chosen category index */);
    callback reject-suggestion(int);

    // Proxies (passwords go to the OS credential store, never shown back)
    in property <[ProxyItem]> proxies: [];
    in property <[string]> proxy-names: [];
    in property <int> global-proxy-index: 0; // 0 = none, n = proxies[n-1]
    in property <[AccountProxyItem]> account-proxies: [];
    out property <[string]> proxy-kinds: ["SOCKS5", "HTTP CONNECT"];
    out property <[string]> proxy-modes: [@tr("Direct"), @tr("Global default"), @tr("Custom")];
    in-out property <string> proxy-test-result: "";
    callback refresh-proxies();
    callback save-proxy(int /* id, 0 = new */, string /* name */, int /* kind */, string /* host */, string /* port */, string /* username */, string /* password */, bool /* password changed */);
    callback delete-proxy(int);
    callback set-global-proxy(int /* index into proxy-names with 0 = none */);
    callback set-account-proxy(int /* account id */, int /* mode */, int /* proxy index */);
    callback test-proxy(int /* proxy id */, string /* host */, string /* port */);
    // Dials the account's own server through its current proxy choice.
    callback test-account-proxy(int /* account id */);
    in-out property <string> account-proxy-result: "";

    // Embedding provider
    out property <[string]> embedding-kinds: ["Ollama", @tr("OpenAI-compatible"), @tr("Local (built-in)")];
    in-out property <int> embedding-kind-index: 0;
    in-out property <string> embedding-url: "";
    in-out property <string> embedding-model: "";
    in property <bool> embedding-has-key: false;
    in property <string> embedding-result: "";
    in property <string> embedding-notice: "";
    // Shown after a save changed the model/dimension and old vectors exist.
    in-out property <bool> embedding-rebuild-prompt: false;
    in property <string> embedding-rebuild-text: "";
    callback refresh-embedding();
    callback test-embedding(int /* kind */, string /* url */, string /* model */, string /* key */);
    callback save-embedding(int /* kind */, string /* url */, string /* model */, string /* key */, bool /* key changed */);
    callback rebuild-embedding-index();
}

component SubTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    height: 30px;
    width: label.preferred-width + 24px;
    border-radius: 6px;
    background: root.selected ? AppTheme.accent-soft : touch.has-hover ? AppTheme.selected-row : transparent;
    label := Text { text: root.text; color: root.selected ? AppTheme.accent : AppTheme.body; font-size: TypeScale.secondary; vertical-alignment: center; horizontal-alignment: center; }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component SiftmailSubTabs inherits HorizontalLayout {
    spacing: 6px;
    alignment: start;
    SubTab { text: @tr("Categories"); selected: SiftmailBridge.page == "categories"; clicked => { SiftmailBridge.page = "categories"; SiftmailBridge.refresh-categories(); } }
    SubTab { text: @tr("Proxies"); selected: SiftmailBridge.page == "proxies"; clicked => { SiftmailBridge.page = "proxies"; SiftmailBridge.refresh-proxies(); } }
    SubTab { text: @tr("Embeddings"); selected: SiftmailBridge.page == "embedding"; clicked => { SiftmailBridge.page = "embedding"; SiftmailBridge.refresh-embedding(); } }
    SubTab { text: @tr("Sync scheduler"); selected: SiftmailBridge.page == "scheduler"; clicked => { SiftmailBridge.page = "scheduler"; SiftmailBridge.refresh-scheduler(); } }
}

export component SchedulerPanel inherits VerticalLayout {
    spacing: 8px;
    Text { text: @tr("Accounts on one provider share a backoff: after a throttle or ban-like error the provider waits 1 h, doubling up to 24 h (±20%). Each provider allows 2 concurrent polling connections."); wrap: word-wrap; color: AppTheme.secondary; font-size: TypeScale.secondary; }
    HorizontalLayout {
        alignment: start;
        spacing: 8px;
        Button { text: @tr("Refresh"); clicked => { SiftmailBridge.refresh-scheduler(); } }
    }
    if SiftmailBridge.scheduler-rows.length == 0 : Text { text: @tr("No accounts yet."); color: AppTheme.muted; }
    for row in SiftmailBridge.scheduler-rows : Rectangle {
        height: max(56px, content.preferred-height + 16px);
        background: AppTheme.surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: row.backing-off ? #d1242f : AppTheme.border-subtle;
        content := HorizontalLayout {
            padding: 10px;
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text { text: row.provider; color: AppTheme.heading; font-weight: 600; }
                Text { text: row.accounts; color: AppTheme.secondary; font-size: TypeScale.secondary; wrap: word-wrap; }
                if row.last-error != "" : Text { text: row.last-error; color: AppTheme.muted; font-size: TypeScale.secondary; wrap: word-wrap; }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: row.backing-off ? @tr("Backing off (level {}) · {}", row.level, row.remaining) : @tr("OK");
                    color: row.backing-off ? #d1242f : #1a7f37;
                    horizontal-alignment: right;
                }
            }
            if row.backing-off : VerticalLayout {
                alignment: center;
                Button { text: @tr("Reset"); clicked => { SiftmailBridge.reset-backoff(row.provider); } }
            }
        }
    }
}

component Card inherits Rectangle {
    background: AppTheme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: AppTheme.border-subtle;
    height: max(40px, inner.preferred-height);
    inner := VerticalLayout { padding: 12px; spacing: 8px; @children }
}

component SectionTitle inherits Text { color: AppTheme.heading; font-weight: 600; font-size: TypeScale.body; }

export component CategoriesPanel inherits VerticalLayout {
    spacing: 12px;
    // --- categories ---
    Card {
        SectionTitle { text: @tr("Categories"); }
        for c in SiftmailBridge.categories : HorizontalLayout {
            spacing: 8px;
            cname := LineEdit { text: c.name; horizontal-stretch: 1; input-label: @tr("Name"); }
            cdesc := LineEdit { text: c.description; horizontal-stretch: 2; placeholder-text: @tr("Description (helps AI suggestions)"); input-label: @tr("Description"); }
            Button { text: @tr("Save"); clicked => { SiftmailBridge.save-category(c.id, cname.text, cdesc.text); } }
            Button { text: @tr("Delete"); destructive: true; clicked => { SiftmailBridge.delete-category(c.id); } }
        }
        HorizontalLayout {
            spacing: 8px;
            new-name := LineEdit { placeholder-text: @tr("New category name"); horizontal-stretch: 1; input-label: @tr("Name"); }
            new-desc := LineEdit { placeholder-text: @tr("Description"); horizontal-stretch: 2; input-label: @tr("Description"); }
            Button { text: @tr("Add"); primary: true; enabled: new-name.text != ""; clicked => { SiftmailBridge.save-category("", new-name.text, new-desc.text); new-name.text = ""; new-desc.text = ""; } }
        }
    }
    // --- rules ---
    Card {
        SectionTitle { text: @tr("Rules"); }
        Text { text: @tr("Rules run before AI and only assign a category. Match by subject, keyword or sender."); wrap: word-wrap; color: AppTheme.secondary; font-size: TypeScale.secondary; }
        for r in SiftmailBridge.rules : HorizontalLayout {
            spacing: 6px;
            if !r.editable : Text { text: r.name + " → " + r.category-name + " · " + r.summary; color: AppTheme.body; horizontal-stretch: 1; vertical-alignment: center; wrap: word-wrap; }
            if r.editable : HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                rname := LineEdit { text: r.name; width: 120px; input-label: @tr("Rule name"); }
                rfield := ComboBox { model: SiftmailBridge.rule-fields; current-index: r.field-index; width: 140px; }
                rop := ComboBox { model: SiftmailBridge.rule-ops; current-index: r.op-index; width: 110px; }
                rval := LineEdit { text: r.value; horizontal-stretch: 1; input-label: @tr("Value"); }
                rcat := ComboBox { model: SiftmailBridge.category-names; current-index: r.category-index; width: 130px; }
                Button { text: @tr("Save"); clicked => { SiftmailBridge.save-rule(r.id, rcat.current-index, rname.text, rfield.current-index, rop.current-index, rval.text, r.enabled); } }
            }
            Button { text: r.enabled ? @tr("Disable") : @tr("Enable"); enabled: r.editable; clicked => { SiftmailBridge.save-rule(r.id, r.category-index, r.name, r.field-index, r.op-index, r.value, !r.enabled); } }
            Button { text: @tr("Delete"); destructive: true; clicked => { SiftmailBridge.delete-rule(r.id); } }
        }
        HorizontalLayout {
            spacing: 6px;
            nname := LineEdit { placeholder-text: @tr("Rule name"); width: 120px; input-label: @tr("Rule name"); }
            nfield := ComboBox { model: SiftmailBridge.rule-fields; current-index: 0; width: 140px; }
            nop := ComboBox { model: SiftmailBridge.rule-ops; current-index: 0; width: 110px; }
            nval := LineEdit { placeholder-text: @tr("Text to match"); horizontal-stretch: 1; input-label: @tr("Value"); }
            ncat := ComboBox { model: SiftmailBridge.category-names; current-index: 0; width: 130px; }
            Button { text: @tr("Add rule"); primary: true; enabled: nval.text != "" && SiftmailBridge.category-names.length > 0; clicked => { SiftmailBridge.save-rule(0, ncat.current-index, nname.text, nfield.current-index, nop.current-index, nval.text, true); nval.text = ""; nname.text = ""; } }
        }
        HorizontalLayout { alignment: start; Button { text: @tr("Apply rules to recent mail"); clicked => { SiftmailBridge.apply-rules-now(); } } }
    }
    // --- AI suggestion review ---
    Card {
        SectionTitle { text: @tr("AI suggestions to review"); }
        Text { text: @tr("The AI only suggests. Nothing changes until you accept, and accepting only applies the category you pick here."); wrap: word-wrap; color: AppTheme.secondary; font-size: TypeScale.secondary; }
        HorizontalLayout { alignment: start; spacing: 8px;
            Button { text: @tr("Ask AI for suggestions"); clicked => { SiftmailBridge.run-ai-suggestions(); } }
            Button { text: @tr("Refresh"); clicked => { SiftmailBridge.refresh-categories(); } }
        }
        if SiftmailBridge.suggestions.length == 0 : Text { text: @tr("No pending suggestions."); color: AppTheme.muted; }
        for sg in SiftmailBridge.suggestions : HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                Text { text: sg.title; color: AppTheme.heading; overflow: elide; }
                Text { text: sg.category-name + " · " + sg.confidence + (sg.rationale != "" ? " · " + sg.rationale : ""); color: AppTheme.secondary; font-size: TypeScale.secondary; wrap: word-wrap; }
            }
            scat := ComboBox { model: SiftmailBridge.category-names; current-index: sg.category-index; width: 140px; }
            Button { text: @tr("Accept"); primary: true; clicked => { SiftmailBridge.accept-suggestion(sg.id, scat.current-index); } }
            Button { text: @tr("Reject"); clicked => { SiftmailBridge.reject-suggestion(sg.id); } }
        }
    }
}

export component ProxiesPanel inherits VerticalLayout {
    spacing: 12px;
    Card {
        SectionTitle { text: @tr("Shared proxies"); }
        Text { text: @tr("IMAP, SMTP and OAuth token refresh connect through the chosen proxy; TLS stays end to end. Passwords are kept in Windows Credential Manager, not in the database."); wrap: word-wrap; color: AppTheme.secondary; font-size: TypeScale.secondary; }
        for p in SiftmailBridge.proxies : VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 6px;
                pname := LineEdit { text: p.name; width: 110px; input-label: @tr("Name"); }
                pkind := ComboBox { model: SiftmailBridge.proxy-kinds; current-index: p.kind-index; width: 130px; }
                phost := LineEdit { text: p.host; horizontal-stretch: 1; input-label: @tr("Host"); }
                pport := LineEdit { text: p.port; width: 70px; input-label: @tr("Port"); }
                puser := LineEdit { text: p.username; width: 110px; placeholder-text: @tr("Username"); input-label: @tr("Username"); }
                ppass := LineEdit { input-type: password; width: 110px; placeholder-text: p.has-password ? "••••••" : @tr("Password"); input-label: @tr("Password"); }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                Button { text: @tr("Save"); clicked => { SiftmailBridge.save-proxy(p.id, pname.text, pkind.current-index, phost.text, pport.text, puser.text, ppass.text, ppass.text != ""); ppass.text = ""; } }
                Button { text: @tr("Test"); clicked => { SiftmailBridge.test-proxy(p.id, "", ""); } }
                Button { text: @tr("Delete"); destructive: true; clicked => { SiftmailBridge.delete-proxy(p.id); } }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            nname := LineEdit { placeholder-text: @tr("Name"); width: 110px; input-label: @tr("Name"); }
            nkind := ComboBox { model: SiftmailBridge.proxy-kinds; current-index: 0; width: 130px; }
            nhost := LineEdit { placeholder-text: "192.168.1.10"; horizontal-stretch: 1; input-label: @tr("Host"); }
            nport := LineEdit { placeholder-text: "1080"; width: 70px; input-label: @tr("Port"); }
            nuser := LineEdit { placeholder-text: @tr("Username"); width: 110px; input-label: @tr("Username"); }
            npass := LineEdit { input-type: password; placeholder-text: @tr("Password"); width: 110px; input-label: @tr("Password"); }
            Button { text: @tr("Add"); primary: true; enabled: nhost.text != "" && nport.text != ""; clicked => { SiftmailBridge.save-proxy(0, nname.text, nkind.current-index, nhost.text, nport.text, nuser.text, npass.text, npass.text != ""); nhost.text = ""; npass.text = ""; } }
        }
        if SiftmailBridge.proxy-test-result != "" : Text { text: SiftmailBridge.proxy-test-result; color: AppTheme.secondary; wrap: word-wrap; }
    }
    Card {
        SectionTitle { text: @tr("Global default proxy"); }
        HorizontalLayout {
            spacing: 8px;
            Text { text: @tr("Accounts set to “Global default” use:"); vertical-alignment: center; color: AppTheme.body; }
            ComboBox { model: SiftmailBridge.proxy-names; current-index: SiftmailBridge.global-proxy-index; width: 200px; selected => { SiftmailBridge.set-global-proxy(self.current-index); } }
        }
    }
    Card {
        SectionTitle { text: @tr("Per-account proxy"); }
        for a in SiftmailBridge.account-proxies : HorizontalLayout {
            spacing: 8px;
            Text { text: a.email; horizontal-stretch: 1; vertical-alignment: center; color: AppTheme.body; overflow: elide; }
            amode := ComboBox { model: SiftmailBridge.proxy-modes; current-index: a.mode-index; width: 150px; selected => { if self.current-index != 2 { SiftmailBridge.set-account-proxy(a.account-id, self.current-index, 0); } } }
            aproxy := ComboBox { model: SiftmailBridge.proxy-names; current-index: a.proxy-index; width: 180px; enabled: amode.current-index == 2; selected => { SiftmailBridge.set-account-proxy(a.account-id, 2, self.current-index); } }
            Button { text: @tr("Test"); clicked => { SiftmailBridge.test-account-proxy(a.account-id); } }
        }
        if SiftmailBridge.account-proxy-result != "" : Text { text: SiftmailBridge.account-proxy-result; color: AppTheme.secondary; wrap: word-wrap; }
        Text { text: @tr("Changes apply on the account's next connection."); color: AppTheme.muted; font-size: TypeScale.secondary; }
    }
}

/// Compact per-account proxy choice for the regular account list in
/// Settings → Accounts (same data as the Siftmail proxy page).
export component AccountProxyControl inherits HorizontalLayout {
    in property <int> account-id;
    spacing: 6px;
    height: 30px;
    init => { if SiftmailBridge.account-proxies.length == 0 { SiftmailBridge.refresh-proxies(); } }
    for a in SiftmailBridge.account-proxies : HorizontalLayout {
        spacing: 6px;
        if a.account-id == root.account-id : Text { text: @tr("Proxy"); color: AppTheme.secondary; font-size: TypeScale.caption; vertical-alignment: center; }
        if a.account-id == root.account-id : ComboBox { model: SiftmailBridge.proxy-modes; current-index: a.mode-index; width: 130px; selected => { if self.current-index != 2 { SiftmailBridge.set-account-proxy(a.account-id, self.current-index, 0); } } }
        if a.account-id == root.account-id && a.mode-index == 2 : ComboBox { model: SiftmailBridge.proxy-names; current-index: a.proxy-index; width: 150px; selected => { SiftmailBridge.set-account-proxy(a.account-id, 2, self.current-index); } }
        if a.account-id == root.account-id : Button { text: @tr("Test"); height: 28px; clicked => { SiftmailBridge.test-account-proxy(a.account-id); } }
    }
}

export component EmbeddingPanel inherits VerticalLayout {
    spacing: 12px;
    Card {
        SectionTitle { text: @tr("Embedding provider"); }
        Text { text: @tr("Used for semantic search. Ollama can run on this PC or another machine on your LAN (e.g. http://192.168.1.20:11434); an optional bearer token is kept in the credential store. Requests bypass the system proxy."); wrap: word-wrap; color: AppTheme.secondary; font-size: TypeScale.secondary; }
        HorizontalLayout {
            spacing: 8px;
            Text { text: @tr("Provider"); width: 110px; vertical-alignment: center; color: AppTheme.body; }
            kind := ComboBox { model: SiftmailBridge.embedding-kinds; current-index <=> SiftmailBridge.embedding-kind-index; width: 220px; }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: @tr("Base URL"); width: 110px; vertical-alignment: center; color: AppTheme.body; }
            url := LineEdit { text <=> SiftmailBridge.embedding-url; enabled: kind.current-index != 2; placeholder-text: kind.current-index == 0 ? "http://127.0.0.1:11434" : "https://api.openai.com/v1"; horizontal-stretch: 1; input-label: @tr("Base URL"); }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: @tr("Model"); width: 110px; vertical-alignment: center; color: AppTheme.body; }
            model := LineEdit { text <=> SiftmailBridge.embedding-model; placeholder-text: kind.current-index == 0 ? "bge-m3" : "text-embedding-3-small"; horizontal-stretch: 1; input-label: @tr("Model"); }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: kind.current-index == 0 ? @tr("Bearer token") : @tr("API key"); width: 110px; vertical-alignment: center; color: AppTheme.body; }
            key := LineEdit { input-type: password; enabled: kind.current-index != 2; placeholder-text: SiftmailBridge.embedding-has-key ? "•••••• (" + @tr("saved") + ")" : @tr("Optional"); horizontal-stretch: 1; input-label: @tr("Key"); }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button { text: @tr("Test connection"); enabled: kind.current-index != 2; clicked => { SiftmailBridge.test-embedding(kind.current-index, url.text, model.text, key.text); } }
            Button { text: @tr("Save"); primary: true; clicked => { SiftmailBridge.save-embedding(kind.current-index, url.text, model.text, key.text, key.text != ""); key.text = ""; } }
        }
        if SiftmailBridge.embedding-notice != "" : Text { text: "⚠ " + SiftmailBridge.embedding-notice; color: #c0392b; wrap: word-wrap; }
        if SiftmailBridge.embedding-result != "" : Text { text: SiftmailBridge.embedding-result; color: AppTheme.secondary; wrap: word-wrap; }
    }
    if SiftmailBridge.embedding-rebuild-prompt : Rectangle {
        background: AppTheme.accent-pale;
        border-radius: 8px;
        border-width: 1px;
        border-color: AppTheme.accent;
        height: rb.preferred-height;
        rb := VerticalLayout {
            padding: 12px;
            spacing: 8px;
            SectionTitle { text: @tr("Rebuild the search index?"); }
            Text { text: SiftmailBridge.embedding-rebuild-text; wrap: word-wrap; color: AppTheme.body; }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button { text: @tr("Rebuild now"); primary: true; clicked => { SiftmailBridge.rebuild-embedding-index(); } }
                Button { text: @tr("Later"); clicked => { SiftmailBridge.embedding-rebuild-prompt = false; } }
            }
        }
    }
}

export component SiftmailPage inherits VerticalLayout {
    spacing: 12px;
    SiftmailSubTabs { }
    if SiftmailBridge.status != "" : Text { text: SiftmailBridge.status; color: AppTheme.secondary; wrap: word-wrap; }
    if SiftmailBridge.page == "scheduler" : SchedulerPanel { }
    if SiftmailBridge.page == "categories" : CategoriesPanel { }
    if SiftmailBridge.page == "proxies" : ProxiesPanel { }
    if SiftmailBridge.page == "embedding" : EmbeddingPanel { }
}
